_const_ns: dict = {}
exec(_const_src.replace("from homeassistant", "# from homeassistant"), _const_ns)  # noqa: S102

for _k, _v in _const_ns.items():
    if not _k.startswith("__"):
        setattr(_svb_const, _k, _v)
