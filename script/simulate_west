# ---------------------------------------------------------------------------
# Mock HA state / services
# ---------------------------------------------------------------------------


class _MockCoverState:
    def __init__(self, position: float, tilt: float) -> None:
        self.attributes = {"current_position": position, "current_tilt_position": tilt}


class _MockStates:
    def __init__(self, position: float = 100.0, tilt: float = 100.0) -> None:
        self.position = position
        self.tilt = tilt

    def get(self, _entity_id: str) -> _MockCoverState:
        return _MockCoverState(self.position, self.tilt)


class _MockServices:
    def __init__(self, states: _MockStates) -> None:
        self._states = states

    async def async_call(self, _domain: str, service: str, data: dict, *, blocking: bool = False) -> None:
        if service == "set_cover_position":
            self._states.position = float(data["position"])
            if self._states.position >= 99.0:
                self._states.tilt = 100.0
            elif self._states.position <= 1.0:
                # Driving to 0% physically resets slats to 0°
                self._states.tilt = 0.0
        elif service == "set_cover_tilt_position":
            self._states.tilt = float(data["tilt_position"])


class MockHass:
    def __init__(self, position: float = 100.0, tilt: float = 100.0) -> None:
        self.states = _MockStates(position, tilt)
        self.services = _MockServices(self.states)


# ---------------------------------------------------------------------------
# Sun position helpers
# ---------------------------------------------------------------------------


def _sun_elevation_azimuth(dt_utc: datetime) -> tuple[float, float]:
    """Return (elevation_deg, azimuth_deg) for St. Gallen at the given UTC datetime."""
    lat = math.radians(LOCATION.latitude)
    n = dt_utc.timetuple().tm_yday
    # Solar declination
    decl = math.radians(23.45 * math.sin(math.radians(360 / 365 * (n - 80))))
    # Equation of time (minutes)
    b = math.radians(360 / 365 * (n - 81))
    eot = 9.87 * math.sin(2 * b) - 7.53 * math.cos(b) - 1.5 * math.sin(b)
    # Solar time
    lon_deg = LOCATION.longitude
    solar_noon = 12.0 - (lon_deg - 15 * round(lon_deg / 15)) / 15 - eot / 60
    hour_utc = dt_utc.hour + dt_utc.minute / 60
    # CEST is UTC+2
    solar_hour = hour_utc + 2 - solar_noon
    ha = math.radians(15 * solar_hour)  # hour angle
    # Elevation
    sin_el = math.sin(lat) * math.sin(decl) + math.cos(lat) * math.cos(decl) * math.cos(ha)
    elevation = math.degrees(math.asin(max(-1, min(1, sin_el))))
    # Azimuth (N=0, E=90, S=180, W=270)
    cos_az = (math.sin(decl) - math.sin(lat) * sin_el) / (math.cos(lat) * math.cos(math.radians(elevation)))
    az = math.degrees(math.acos(max(-1, min(1, cos_az))))
    if solar_hour > 0:
        az = 360 - az
    return elevation, az


# ---------------------------------------------------------------------------
# Cover configuration factory
# ---------------------------------------------------------------------------
_FACADE_AZIMUTH = 267
_SLAT_WIDTH = 70
_SLAT_SPACING = 90
_SAFETY_MARGIN = 0


def _make_config(label: str, **overrides: object) -> CoverConfig:
    defaults: dict[str, object] = dict(
        entity_id=f"cover.west_{label}",
        drive_position=0,
        min_angle=0,
        max_angle=90,
        invert_tilt=False,
        no_sun_behavior="open",
        no_sun_position=100,
        respect_manual_close=True,
        manual_close_threshold=5,
        respect_manual_open=True,
        manual_open_threshold=90,
        minimum_tilt_change=5,
        enabled=True,
        reflection_protection_enabled=False,
        reflection_protection_min_tilt=30,
        reflection_protection_start_time="00:00",
        reflection_protection_end_time="23:59",
        min_tilt_percent=0,
        obstacle_elevation_deg=0.0,
    )
    defaults.update(overrides)
    return CoverConfig(**defaults)  # type: ignore[arg-type]


COVER_1 = _make_config("cover1", min_tilt_percent=42, obstacle_elevation_deg=17.0)
COVER_2 = _make_config("cover2", min_tilt_percent=38, obstacle_elevation_deg=0.0)

# ---------------------------------------------------------------------------
# Simulation
# ---------------------------------------------------------------------------


class StepResult(NamedTuple):
    time_cest: str
    elevation: float
    azimuth: float
    ratio: float | None
    calc_tilt: float | None
    cover_tilt: float
    cover_position: float


async def _simulate_cover(config: CoverConfig, steps: list[datetime]) -> list[StepResult]:
    hass = MockHass(position=0.0, tilt=100.0)
    tracking = CoverTrackingState()
    results: list[StepResult] = []

    sep = "─" * 80
    print(f"\n{sep}")
    print(
        f"  COVER: {config.entity_id}  |  min_tilt={config.min_tilt_percent}%  |  obstacle={config.obstacle_elevation_deg}°"
    )
    print(sep)

    for dt_utc in steps:
        elevation, azimuth = _sun_elevation_azimuth(dt_utc)
        # CEST = UTC+2
        cest_hour = dt_utc.hour + 2
        cest_min = dt_utc.minute
        time_label = f"{cest_hour:02d}:{cest_min:02d}"

        calculation = None
        ratio: float | None = None
        calc_tilt: float | None = None

        if elevation > 0:
            sun = SunPosition(azimuth_deg=azimuth, elevation_deg=elevation)
            calculation = calculate_slat_angle(
                sun=sun,
                facade_azimuth_deg=_FACADE_AZIMUTH,
                slat_width_mm=_SLAT_WIDTH,
                slat_spacing_mm=_SLAT_SPACING,
                safety_margin_deg=_SAFETY_MARGIN,
            )
            if calculation is not None and not calculation.sun_is_behind_facade:
                omega = calculation.profile_angle_deg
                cos_omega = math.cos(math.radians(omega))
                ratio = (_SLAT_SPACING * cos_omega) / _SLAT_WIDTH
                calc_tilt = calculation.slat_tilt_percent

        ctx = CoverContext(config=config, calculation=calculation, hass=hass, state=tracking)
        pipeline = Pipeline(
            [
                EnabledPipe(),
                SleepProtectionPipe(),
                ExitPausedCheckPipe(),
                NoSunPipe(5),
                ExitDetectionPipe(),
                PositionDrivePipe(5, 0),
                TiltPipe(),
            ]
        )

        prefix = f"{time_label} CEST | el={elevation:+5.1f}° az={azimuth:5.1f}°"
        if ratio is not None:
            ratio_str = f"ratio={ratio:.3f}"
            calc_str = f"calc={calc_tilt:5.1f}%"
        elif calculation is not None and calculation.sun_is_behind_facade:
            ratio_str = "BEHIND FACADE "
            calc_str = "             "
        else:
            ratio_str = "SUN BELOW HOR."
            calc_str = "             "

        print(f"\n{prefix} | {ratio_str} | {calc_str}")

        tilt_before = hass.states.tilt
        pos_before = hass.states.position
        await pipeline.run(ctx)
        tilt_after = hass.states.tilt
        pos_after = hass.states.position

        if abs(tilt_after - tilt_before) > 0.01 or abs(pos_after - pos_before) > 0.01:
            print(
                f"      → cover: pos={pos_after:.0f}%  tilt={tilt_after:.1f}%  (was pos={pos_before:.0f}%  tilt={tilt_before:.1f}%)"
            )
        else:
            print(f"      → cover: pos={pos_after:.0f}%  tilt={tilt_after:.1f}%  (no change)")

        results.append(
            StepResult(
                time_cest=time_label,
                elevation=elevation,
                azimuth=azimuth,
                ratio=ratio,
                calc_tilt=calc_tilt,
                cover_tilt=tilt_after,
                cover_position=pos_after,
            )
        )

    return results


def _build_steps() -> list[datetime]:
    """Build 4-minute UTC steps from 11:00 UTC (13:00 CEST) to 19:00 UTC (21:00 CEST)."""
    return [datetime(2026, 4, 14, h, m, tzinfo=UTC) for h in range(11, 20) for m in range(0, 60, 4)]


async def _main() -> None:
    steps = _build_steps()

    results1 = await _simulate_cover(COVER_1, steps)
    results2 = await _simulate_cover(COVER_2, steps)

    # Summary table
    print("\n\n" + "═" * 100)
    print("  SUMMARY TABLE — West Facade April 14, 2026")
    print("═" * 100)
    print(
        f"  {'Time':>5}  {'El':>6}  {'Az':>6}  {'Ratio':>7}  {'CalcTilt':>9}  {'Cover1 Tilt':>12}  {'Cover1 Pos':>11}  {'Cover2 Tilt':>12}  {'Cover2 Pos':>11}"
    )
    print("─" * 100)
    for r1, r2 in zip(results1, results2, strict=False):
        ratio_s = f"{r1.ratio:7.3f}" if r1.ratio is not None else "  behind"
        calc_s = f"{r1.calc_tilt:8.1f}%" if r1.calc_tilt is not None else "         "
        flag1 = (
            " ←!" if r1.cover_tilt < 5 else ("  ↓" if r1.calc_tilt is not None and r1.calc_tilt < r1.cover_tilt else "")
        )
        flag2 = " ←!" if r2.cover_tilt < 5 else ""
        print(
            f"  {r1.time_cest}  {r1.elevation:+6.1f}°  {r1.azimuth:6.1f}°  {ratio_s}  {calc_s}"
            f"  {r1.cover_tilt:11.1f}%  {r1.cover_position:10.0f}%"
            f"  {r2.cover_tilt:11.1f}%  {r2.cover_position:10.0f}%"
            f"{flag1}{flag2}"
        )


if __name__ == "__main__":
    asyncio.run(_main())
