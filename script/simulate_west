_ha_const.ATTR_ENTITY_ID = "entity_id"  # type: ignore[attr-defined]
_ha_const.SERVICE_SET_COVER_POSITION = "set_cover_position"  # type: ignore[attr-defined]
_ha_const.SERVICE_SET_COVER_TILT_POSITION = "set_cover_tilt_position"  # type: ignore[attr-defined]
_ha_components = types.ModuleType("homeassistant.components")
