_ha_core = types.ModuleType("homeassistant.core")
_ha_core.Event = object  # type: ignore[attr-defined]
_ha_core.EventStateChangedData = object  # type: ignore[attr-defined]
_ha_core.HomeAssistant = object  # type: ignore[attr-defined]
_ha_core.State = object  # type: ignore[attr-defined]
_ha_core.callback = lambda f: f  # type: ignore[attr-defined]
for _name, _stub in {
    "homeassistant": _ha,
    "homeassistant.const": _ha_const,
    "homeassistant.components": _ha_components,
    "homeassistant.components.cover": _ha_cover,
    "homeassistant.helpers": _ha_helpers,
    "homeassistant.helpers.config_validation": _ha_cv,
    "homeassistant.helpers.update_coordinator": _ha_coordinator,
    "homeassistant.loader": _ha_loader,
    "homeassistant.util": _ha_util,
    "homeassistant.util.dt": _ha_dt,
    "homeassistant.core": _ha_core,
}.items():
    sys.modules[_name] = _stub

_svb_root = str(Path(__file__).parent.parent / "custom_components" / "smart_venetian_blinds")
_svb_pkg = types.ModuleType("custom_components.smart_venetian_blinds")
_svb_pkg.__path__ = [_svb_root]  # type: ignore[attr-defined]
_svb_pkg.__package__ = "custom_components.smart_venetian_blinds"
_svb_const = types.ModuleType("custom_components.smart_venetian_blinds.const")

# Inject constants needed by the pipeline
_LOGGER = logging.getLogger("smart_venetian_blinds")
_svb_const.LOGGER = _LOGGER  # type: ignore[attr-defined]
