import sys
import types
from typing import NamedTuple

# ---------------------------------------------------------------------------
# Sun position via astral
# ---------------------------------------------------------------------------
from astral import LocationInfo

LOCATION = LocationInfo(
    name="St. Gallen",
    region="Switzerland",
    timezone="Europe/Zurich",
    latitude=47.4227,
    longitude=9.3731,
)
SIM_DATE = date(2026, 4, 14)
SIM_TZ = LOCATION.tzinfo

# ---------------------------------------------------------------------------
