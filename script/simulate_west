#!/usr/bin/env python3
"""
Simulate the west-facade cover pipeline for April 14, 2026 (St. Gallen).

Reproduces the incident where both west covers ended up at 0% tilt despite
min_tilt=42% being configured. Runs the real pipeline with real sun positions
and full DEBUG logging so every pipe decision is visible.

Usage:
    python3 script/simulate_west

Requirements:
    pip install -r requirements_visualize.txt   (astral, matplotlib)
    -- or just: pip install astral
"""

from __future__ import annotations

import asyncio
from datetime import UTC, date, datetime
