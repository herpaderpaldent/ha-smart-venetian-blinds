_ha_helpers = types.ModuleType("homeassistant.helpers")
_ha_cv = types.ModuleType("homeassistant.helpers.config_validation")
_ha_coordinator = types.ModuleType("homeassistant.helpers.update_coordinator")
_ha_coordinator.DataUpdateCoordinator = object  # type: ignore[attr-defined]
