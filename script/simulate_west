sys.modules["svb_math"] = _mod
_spec.loader.exec_module(_mod)  # type: ignore[union-attr]

SunPosition = _mod.SunPosition
calculate_slat_angle = _mod.calculate_slat_angle

# ---------------------------------------------------------------------------
# Stub homeassistant so pipeline modules import without a real HA install
# ---------------------------------------------------------------------------
_ha = types.ModuleType("homeassistant")
_ha_const = types.ModuleType("homeassistant.const")
