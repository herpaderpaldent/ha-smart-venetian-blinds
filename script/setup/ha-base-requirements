#!/usr/bin/env python3
"""Resolve the Python requirements of Home Assistant's eagerly imported base components.

Home Assistant validates service call schemas via
``homeassistant.helpers.service._base_components()``, which imports ~19 entity
component modules in one go. Those modules import their dependencies at module
level, so a single missing package raises ``ModuleNotFoundError`` inside the
websocket handler. The frontend only sees ``{"code": "unknown_error"}`` and
onboarding hangs on "Loading data".

Home Assistant itself installs those packages on demand when a component is set
up. The base components are never "set up" in a minimal dev config, so nobody
ever installs them - they are only imported. This script closes that gap.

Rather than pinning a hand-maintained list that silently rots on every Home
Assistant upgrade, the requirements are derived from the installed Home
Assistant itself:

1. Parse ``helpers/service.py`` with ``ast`` to read the component names that
   ``_base_components()`` imports.
2. Walk each component's ``manifest.json``, following ``dependencies``
   recursively (that is what gets imported transitively).
3. Emit the union of the ``requirements`` fields, already pinned by Home
   Assistant.

Usage:
    script/setup/ha-base-requirements            # one requirement per line
    script/setup/ha-base-requirements --explain  # annotate origin on stderr
"""

from __future__ import annotations

import argparse
import ast
from collections import defaultdict
import json
from pathlib import Path
import sys

try:
    import homeassistant
except ImportError:
    sys.exit("homeassistant is not installed in the active environment")

SERVICE_HELPER = Path("helpers") / "service.py"
BASE_COMPONENTS_FUNC = "_base_components"

# Components that are not part of the import closure but whose requirements the
# base components reach for at runtime. ``camera`` hands streams over to
# ``stream`` (an after_dependency, so it is not in the manifest closure), which
# is what pulls in av/numpy.
EXTRA_COMPONENTS = ("stream",)


def homeassistant_root() -> Path:
    """Return the directory of the installed homeassistant package."""
    location = getattr(homeassistant, "__file__", None)
    if location is None:
        sys.exit("cannot determine the location of the homeassistant package")
    return Path(location).parent


def base_component_names(root: Path) -> list[str]:
    """Extract the component names imported by ``_base_components()``."""
    source_file = root / SERVICE_HELPER
    if not source_file.is_file():
        sys.exit(f"cannot read {source_file} - is this a valid Home Assistant install?")

    tree = ast.parse(source_file.read_text(encoding="utf-8"), filename=str(source_file))
    for node in ast.walk(tree):
        if not isinstance(node, ast.FunctionDef) or node.name != BASE_COMPONENTS_FUNC:
            continue
        names = [
            alias.name
            for child in ast.walk(node)
            if isinstance(child, ast.ImportFrom) and child.module == "homeassistant.components"
            for alias in child.names
        ]
        if names:
            return names
        break

    sys.exit(
        f"could not read the component list from {SERVICE_HELPER}::{BASE_COMPONENTS_FUNC}(). "
        "Home Assistant probably restructured it - update script/setup/ha-base-requirements."
    )


def read_manifest(root: Path, component: str) -> dict[str, object]:
    """Return the parsed manifest of a component, or an empty dict if it has none."""
    manifest = root / "components" / component / "manifest.json"
    if not manifest.is_file():
        return {}
    return json.loads(manifest.read_text(encoding="utf-8"))


def collect_requirements(root: Path, components: list[str]) -> dict[str, list[str]]:
    """Walk the dependency closure and map each requirement to the components needing it."""
    requirements: dict[str, list[str]] = defaultdict(list)
    seen: set[str] = set()
    pending = list(components)

    while pending:
        component = pending.pop()
        if component in seen:
            continue
        seen.add(component)

        manifest = read_manifest(root, component)
        for requirement in manifest.get("requirements", []):
            requirements[str(requirement)].append(component)
        pending.extend(str(dependency) for dependency in manifest.get("dependencies", []))

    return requirements


def main() -> int:
    """Print the pinned requirements of Home Assistant's base components."""
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--explain", action="store_true", help="report which component needs what on stderr")
    args = parser.parse_args()

    root = homeassistant_root()
    components = base_component_names(root)
    requirements = collect_requirements(root, [*components, *EXTRA_COMPONENTS])

    if args.explain:
        print(f"Home Assistant: {root}", file=sys.stderr)
        print(f"Base components ({len(components)}): {', '.join(sorted(components))}", file=sys.stderr)
        for requirement in sorted(requirements):
            print(f"  {requirement} <- {', '.join(sorted(requirements[requirement]))}", file=sys.stderr)

    for requirement in sorted(requirements):
        print(requirement)

    return 0


if __name__ == "__main__":
    sys.exit(main())
